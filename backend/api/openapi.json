{
 "components": {
  "schemas": {
   "Accepted": {
    "properties": {
     "job": {
      "title": "Job",
      "type": "string"
     },
     "poll": {
      "title": "Poll",
      "type": "string"
     },
     "status": {
      "title": "Status",
      "type": "string"
     }
    },
    "required": [
     "job",
     "status",
     "poll"
    ],
    "title": "Accepted",
    "type": "object"
   },
   "AssetCounts": {
    "properties": {
     "diagrams": {
      "title": "Diagrams",
      "type": "integer"
     },
     "drawings": {
      "title": "Drawings",
      "type": "integer"
     },
     "images": {
      "title": "Images",
      "type": "integer"
     }
    },
    "required": [
     "images",
     "drawings",
     "diagrams"
    ],
    "title": "AssetCounts",
    "type": "object"
   },
   "AssetInfo": {
    "properties": {
     "file": {
      "title": "File",
      "type": "string"
     },
     "id": {
      "title": "Id",
      "type": "string"
     },
     "kind": {
      "title": "Kind",
      "type": "string"
     }
    },
    "required": [
     "kind",
     "file",
     "id"
    ],
    "title": "AssetInfo",
    "type": "object"
   },
   "AttemptInfo": {
    "properties": {
     "advisory": {
      "default": [],
      "items": {},
      "title": "Advisory",
      "type": "array"
     },
     "attempt": {
      "title": "Attempt",
      "type": "string"
     },
     "blocking": {
      "default": [],
      "items": {},
      "title": "Blocking",
      "type": "array"
     },
     "files": {
      "additionalProperties": {
       "type": "boolean"
      },
      "default": {},
      "title": "Files",
      "type": "object"
     },
     "gate_pass": {
      "anyOf": [
       {
        "type": "boolean"
       },
       {
        "type": "null"
       }
      ],
      "title": "Gate Pass"
     },
     "page_scores": {
      "anyOf": [
       {},
       {
        "type": "null"
       }
      ],
      "title": "Page Scores"
     },
     "pages": {
      "default": [],
      "items": {
       "type": "string"
      },
      "title": "Pages",
      "type": "array"
     },
     "reference_basis": {
      "anyOf": [
       {},
       {
        "type": "null"
       }
      ],
      "title": "Reference Basis"
     }
    },
    "required": [
     "attempt"
    ],
    "title": "AttemptInfo",
    "type": "object"
   },
   "Body_projects_upload_asset": {
    "properties": {
     "file": {
      "contentMediaType": "application/octet-stream",
      "title": "File",
      "type": "string"
     }
    },
    "required": [
     "file"
    ],
    "title": "Body_projects_upload_asset",
    "type": "object"
   },
   "BriefBody": {
    "properties": {
     "markdown": {
      "title": "Markdown",
      "type": "string"
     }
    },
    "required": [
     "markdown"
    ],
    "title": "BriefBody",
    "type": "object"
   },
   "ComposeRequest": {
    "properties": {
     "accent_color": {
      "anyOf": [
       {
        "pattern": "^#[0-9a-fA-F]{6}$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Accent Color"
     },
     "also": {
      "description": "extra exporter backends, e.g. [\"designcraft\"]",
      "items": {
       "type": "string"
      },
      "title": "Also",
      "type": "array"
     },
     "band": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "description": "{\"side\": \"left|top\", \"color\": \"#hex\", \"width_mm\": 6, \"every_page\": true}",
      "title": "Band"
     },
     "bleed_mm": {
      "default": 0,
      "title": "Bleed Mm",
      "type": "number"
     },
     "domain": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Domain"
     },
     "footer": {
      "anyOf": [
       {
        "type": "boolean"
       },
       {
        "type": "null"
       }
      ],
      "title": "Footer"
     },
     "header": {
      "default": true,
      "title": "Header",
      "type": "boolean"
     },
     "height_mm": {
      "default": 210,
      "title": "Height Mm",
      "type": "number"
     },
     "margin_mm": {
      "default": 12,
      "title": "Margin Mm",
      "type": "number"
     },
     "paper_color": {
      "anyOf": [
       {
        "pattern": "^#[0-9a-fA-F]{6}$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Paper Color"
     },
     "text_color": {
      "anyOf": [
       {
        "pattern": "^#[0-9a-fA-F]{6}$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Text Color"
     },
     "width_mm": {
      "default": 297,
      "title": "Width Mm",
      "type": "number"
     }
    },
    "title": "ComposeRequest",
    "type": "object"
   },
   "CutoutRequest": {
    "properties": {
     "engine": {
      "default": "rembg",
      "enum": [
       "rembg",
       "photocraft"
      ],
      "title": "Engine",
      "type": "string"
     },
     "files": {
      "description": "file names under images/ chosen by the host/person",
      "items": {
       "type": "string"
      },
      "minItems": 1,
      "title": "Files",
      "type": "array"
     }
    },
    "required": [
     "files"
    ],
    "title": "CutoutRequest",
    "type": "object"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "title": "Detail",
      "type": "array"
     }
    },
    "title": "HTTPValidationError",
    "type": "object"
   },
   "Job": {
    "properties": {
     "created": {
      "title": "Created",
      "type": "string"
     },
     "error": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Error"
     },
     "finished": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Finished"
     },
     "id": {
      "title": "Id",
      "type": "string"
     },
     "kind": {
      "title": "Kind",
      "type": "string"
     },
     "log": {
      "default": [],
      "items": {
       "type": "string"
      },
      "title": "Log",
      "type": "array"
     },
     "project": {
      "title": "Project",
      "type": "string"
     },
     "result": {
      "anyOf": [
       {},
       {
        "type": "null"
       }
      ],
      "title": "Result"
     },
     "started": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Started"
     },
     "status": {
      "enum": [
       "queued",
       "running",
       "succeeded",
       "failed"
      ],
      "title": "Status",
      "type": "string"
     }
    },
    "required": [
     "id",
     "kind",
     "project",
     "status",
     "created"
    ],
    "title": "Job",
    "type": "object"
   },
   "ManifestOut": {
    "properties": {
     "brief": {
      "additionalProperties": true,
      "title": "Brief",
      "type": "object"
     },
     "manifest": {
      "additionalProperties": true,
      "title": "Manifest",
      "type": "object"
     }
    },
    "required": [
     "manifest",
     "brief"
    ],
    "title": "ManifestOut",
    "type": "object"
   },
   "PlanGenerateRequest": {
    "properties": {
     "compose": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/ComposeRequest"
       },
       {
        "type": "null"
       }
      ],
      "description": "when set, compose right after the plan is written"
     },
     "instructions": {
      "default": "",
      "description": "extra direction for the host LLM (tone, page count, what to emphasise)",
      "title": "Instructions",
      "type": "string"
     }
    },
    "title": "PlanGenerateRequest",
    "type": "object"
   },
   "PlanSaved": {
    "properties": {
     "pages": {
      "title": "Pages",
      "type": "integer"
     },
     "versions": {
      "title": "Versions",
      "type": "integer"
     }
    },
    "required": [
     "pages",
     "versions"
    ],
    "title": "PlanSaved",
    "type": "object"
   },
   "PrepareRequest": {
    "properties": {
     "approve": {
      "default": false,
      "description": "false = only propose sheet trims; true = write the trimmed copies (originals stay in sources/)",
      "title": "Approve",
      "type": "boolean"
     },
     "knockout": {
      "default": false,
      "description": "make the drawings' paper transparent",
      "title": "Knockout",
      "type": "boolean"
     },
     "knockout_files": {
      "description": "extra files relative to the project, e.g. diagrams/overlay_plan.png",
      "items": {
       "type": "string"
      },
      "title": "Knockout Files",
      "type": "array"
     },
     "levels": {
      "default": false,
      "title": "Levels",
      "type": "boolean"
     }
    },
    "title": "PrepareRequest",
    "type": "object"
   },
   "ProjectCreate": {
    "properties": {
     "brief": {
      "default": "",
      "description": "project.md markdown (facts the book may quote); default template if empty",
      "title": "Brief",
      "type": "string"
     },
     "id": {
      "description": "lowercase letters, digits, - and _",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Id",
      "type": "string"
     },
     "title": {
      "default": "",
      "title": "Title",
      "type": "string"
     }
    },
    "required": [
     "id"
    ],
    "title": "ProjectCreate",
    "type": "object"
   },
   "ProjectInfo": {
    "properties": {
     "assets": {
      "$ref": "#/components/schemas/AssetCounts"
     },
     "attempts": {
      "title": "Attempts",
      "type": "integer"
     },
     "created": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Created"
     },
     "has_plan": {
      "title": "Has Plan",
      "type": "boolean"
     },
     "id": {
      "title": "Id",
      "type": "string"
     },
     "title": {
      "default": "",
      "title": "Title",
      "type": "string"
     }
    },
    "required": [
     "id",
     "assets",
     "has_plan",
     "attempts"
    ],
    "title": "ProjectInfo",
    "type": "object"
   },
   "ReviewRecord": {
    "properties": {
     "review": {
      "additionalProperties": true,
      "description": "review JSON as described in reviewAgent (hashes copied verbatim from review-context)",
      "title": "Review",
      "type": "object"
     }
    },
    "required": [
     "review"
    ],
    "title": "ReviewRecord",
    "type": "object"
   },
   "ValidationError": {
    "properties": {
     "ctx": {
      "title": "Context",
      "type": "object"
     },
     "input": {
      "title": "Input"
     },
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "title": "Location",
      "type": "array"
     },
     "msg": {
      "title": "Message",
      "type": "string"
     },
     "type": {
      "title": "Error Type",
      "type": "string"
     }
    },
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError",
    "type": "object"
   }
  }
 },
 "info": {
  "description": "HTTP service over the portfolio agents: sources -> book plan -> composed book -> fresh review.",
  "title": "Pascal API",
  "version": "0.2.0"
 },
 "openapi": "3.1.0",
 "paths": {
  "/catalog": {
   "get": {
    "description": "Roles, page flags, grid systems, compositions, photo-set templates, exporter backends: what a book plan may use.",
    "operationId": "catalog_get_catalog",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {}
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "Get Catalog",
    "tags": [
     "catalog"
    ]
   }
  },
  "/health": {
   "get": {
    "operationId": "meta_health",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {}
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "Health",
    "tags": [
     "meta"
    ]
   }
  },
  "/jobs": {
   "get": {
    "operationId": "jobs_list_jobs",
    "parameters": [
     {
      "in": "query",
      "name": "project",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Project"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/Job"
         },
         "title": "Response Jobs List Jobs",
         "type": "array"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "List Jobs",
    "tags": [
     "jobs"
    ]
   }
  },
  "/jobs/{jid}": {
   "get": {
    "operationId": "jobs_get_job",
    "parameters": [
     {
      "in": "path",
      "name": "jid",
      "required": true,
      "schema": {
       "title": "Jid",
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Job"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Get Job",
    "tags": [
     "jobs"
    ]
   }
  },
  "/projects": {
   "get": {
    "operationId": "projects_list_projects",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/ProjectInfo"
         },
         "title": "Response Projects List Projects",
         "type": "array"
        }
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "List Projects",
    "tags": [
     "projects"
    ]
   },
   "post": {
    "operationId": "projects_create_project",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ProjectCreate"
       }
      }
     },
     "required": true
    },
    "responses": {
     "201": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ProjectInfo"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Create Project",
    "tags": [
     "projects"
    ]
   }
  },
  "/projects/{pid}": {
   "delete": {
    "operationId": "projects_delete_project",
    "parameters": [
     {
      "in": "path",
      "name": "pid",
      "required": true,
      "schema": {
       "title": "Pid",
       "type": "string"
      }
     }
    ],
    "responses": {
     "204": {
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Delete Project",
    "tags": [
     "projects"
    ]
   },
   "get": {
    "operationId": "projects_get_project",
    "parameters": [
     {
      "in": "path",
      "name": "pid",
      "required": true,
      "schema": {
       "title": "Pid",
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ProjectInfo"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Get Project",
    "tags": [
     "projects"
    ]
   }
  },
  "/projects/{pid}/assets/{kind}": {
   "post": {
    "description": "kind = images | drawings | diagrams. The file name becomes the asset id (stem).",
    "operationId": "projects_upload_asset",
    "parameters": [
     {
      "in": "path",
      "name": "pid",
      "required": true,
      "schema": {
       "title": "Pid",
       "type": "string"
      }
     },
     {
      "in": "path",
      "name": "kind",
      "required": true,
      "schema": {
       "title": "Kind",
       "type": "string"
      }
     }
    ],
    "requestBody": {
     "content": {
      "multipart/form-data": {
       "schema": {
        "$ref": "#/components/schemas/Body_projects_upload_asset"
       }
      }
     },
     "required": true
    },
    "responses": {
     "201": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AssetInfo"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Upload Asset",
    "tags": [
     "projects"
    ]
   }
  },
  "/projects/{pid}/assets/{kind}/{name}": {
   "delete": {
    "operationId": "projects_delete_asset",
    "parameters": [
     {
      "in": "path",
      "name": "pid",
      "required": true,
      "schema": {
       "title": "Pid",
       "type": "string"
      }
     },
     {
      "in": "path",
      "name": "kind",
      "required": true,
      "schema": {
       "title": "Kind",
       "type": "string"
      }
     },
     {
      "in": "path",
      "name": "name",
      "required": true,
      "schema": {
       "title": "Name",
       "type": "string"
      }
     }
    ],
    "responses": {
     "204": {
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Delete Asset",
    "tags": [
     "projects"
    ]
   }
  },
  "/projects/{pid}/attempts": {
   "get": {
    "operationId": "books_list_attempts",
    "parameters": [
     {
      "in": "path",
      "name": "pid",
      "required": true,
      "schema": {
       "title": "Pid",
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/AttemptInfo"
         },
         "title": "Response Books List Attempts",
         "type": "array"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "List Attempts",
    "tags": [
     "books"
    ]
   }
  },
  "/projects/{pid}/attempts/{nn}": {
   "get": {
    "operationId": "books_get_attempt",
    "parameters": [
     {
      "in": "path",
      "name": "pid",
      "required": true,
      "schema": {
       "title": "Pid",
       "type": "string"
      }
     },
     {
      "in": "path",
      "name": "nn",
      "required": true,
      "schema": {
       "title": "Nn",
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AttemptInfo"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Get Attempt",
    "tags": [
     "books"
    ]
   }
  },
  "/projects/{pid}/attempts/{nn}/book.{ext}": {
